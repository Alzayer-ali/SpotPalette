+    /// <summary>
+    /// Recomputes the Spotlight-style layout values (SpotPalette) from the current settings
+    /// and page. When compact mode is off every value falls back to the upstream design.
+    /// </summary>
+    private void ApplySpotlightLayout(bool notify)
+    {
+        var settings = _settingsService.Settings;
+        var spotlight = settings.CompactMode;
+
+        SearchFontSize = spotlight ? settings.SpotlightSearchFontSize : DefaultSearchFontSize;
+        TopBarPadding = spotlight
+            ? new Thickness(0, settings.SpotlightSearchBarPadding, 0, settings.SpotlightSearchBarPadding)
+            : DefaultTopBarPadding;
+        SpotlightShowLogo = !spotlight || !settings.SpotlightHideLogo;
+        CommandBarMaxHeight = spotlight && settings.SpotlightHideCommandBar ? 0 : double.PositiveInfinity;
+
+        // The row limit only makes sense for list pages; content pages (forms, markdown, ...)
+        // keep using all the space they can get.
+        var rows = settings.SpotlightMaxVisibleResults;
+        var isListPage = ViewModel.CurrentPage is ListViewModel;
+        ResultsMaxHeight = spotlight && rows > 0 && isListPage
+            ? (rows * SpotlightResultRowHeight) + SpotlightResultsListPadding
+            : double.PositiveInfinity;
+
+        if (!notify)
+        {
+            return;
+        }
+
+        PropertyChanged?.Invoke(this, new(nameof(SearchFontSize)));
+        PropertyChanged?.Invoke(this, new(nameof(TopBarPadding)));
+        PropertyChanged?.Invoke(this, new(nameof(SpotlightShowLogo)));
+        PropertyChanged?.Invoke(this, new(nameof(CommandBarMaxHeight)));
+        PropertyChanged?.Invoke(this, new(nameof(ResultsMaxHeight)));
+    }
