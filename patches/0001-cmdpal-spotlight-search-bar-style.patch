+            var rows = (int)Math.Round(value, MidpointRounding.AwayFromZero);
+            _settingsService.UpdateSettings(s => s with { SpotlightMaxVisibleResults = rows });
+        }
+    }
+
+    public double SpotlightSearchFontSize
+    {
+        get => _settingsService.Settings.SpotlightSearchFontSize;
+        set
+        {
+            if (double.IsNaN(value))
+            {
+                return;
+            }
+
+            var size = (int)Math.Round(value, MidpointRounding.AwayFromZero);
+            _settingsService.UpdateSettings(s => s with { SpotlightSearchFontSize = size });
+        }
+    }
+
+    public double SpotlightSearchBarPadding
+    {
+        get => _settingsService.Settings.SpotlightSearchBarPadding;
+        set
+        {
+            if (double.IsNaN(value))
+            {
+                return;
+            }
+
+            var padding = (int)Math.Round(value, MidpointRounding.AwayFromZero);
+            _settingsService.UpdateSettings(s => s with { SpotlightSearchBarPadding = padding });
+        }
+    }
+
+    public double SpotlightCornerRadius
+    {
+        get => _settingsService.Settings.SpotlightCornerRadius;
+        set
+        {
+            if (double.IsNaN(value))
+            {
+                return;
+            }
+
+            var radius = (int)Math.Round(value, MidpointRounding.AwayFromZero);
+            _settingsService.UpdateSettings(s => s with { SpotlightCornerRadius = radius });
+        }
+    }
+
+    public bool SpotlightShowCommandBar
+    {
+        get => !_settingsService.Settings.SpotlightHideCommandBar;
+        set => _settingsService.UpdateSettings(s => s with { SpotlightHideCommandBar = !value });
+    }
+
+    public bool SpotlightShowLogo
+    {
+        get => !_settingsService.Settings.SpotlightHideLogo;
+        set => _settingsService.UpdateSettings(s => s with { SpotlightHideLogo = !value });
+    }
+
+    public bool SpotlightShowSectionHeaders
+    {
+        get => !_settingsService.Settings.SpotlightHideSectionHeaders;
+        set => _settingsService.UpdateSettings(s => s with { SpotlightHideSectionHeaders = !value });
+    }
+
+    public void ResetSpotlightStyle()
+    {
+        _settingsService.UpdateSettings(s => s with
+        {
+            SpotlightMaxVisibleResults = SettingsModel.DefaultSpotlightMaxVisibleResults,
+            SpotlightSearchFontSize = SettingsModel.DefaultSpotlightSearchFontSize,
+            SpotlightSearchBarPadding = SettingsModel.DefaultSpotlightSearchBarPadding,
+            SpotlightCornerRadius = SettingsModel.DefaultSpotlightCornerRadius,
+            SpotlightHideCommandBar = true,
+            SpotlightHideLogo = false,
+            SpotlightHideSectionHeaders = false,
+        });
+
+        foreach (var name in new[]
+        {
+            nameof(SpotlightMaxVisibleResults),
+            nameof(SpotlightSearchFontSize),
+            nameof(SpotlightSearchBarPadding),
+            nameof(SpotlightCornerRadius),
+            nameof(SpotlightShowCommandBar),
+            nameof(SpotlightShowLogo),
+            nameof(SpotlightShowSectionHeaders),
+        })
+        {
+            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
+        }
+    }
