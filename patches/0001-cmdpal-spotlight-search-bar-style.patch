+    // SpotPalette: Spotlight-style options (only used while CompactMode is on).
+    public double MaxSpotlightMaxVisibleResults => SettingsModel.MaxSpotlightMaxVisibleResults;
+
+    public double MinSpotlightSearchFontSize => SettingsModel.MinSpotlightSearchFontSize;
+
+    public double MaxSpotlightSearchFontSize => SettingsModel.MaxSpotlightSearchFontSize;
+
+    public double MinSpotlightSearchBarPadding => SettingsModel.MinSpotlightSearchBarPadding;
+
+    public double MaxSpotlightSearchBarPadding => SettingsModel.MaxSpotlightSearchBarPadding;
+
+    public double MaxSpotlightCornerRadius => SettingsModel.MaxSpotlightCornerRadius;
+
+    public double SpotlightMaxVisibleResults
+    {
+        get => _settingsService.Settings.SpotlightMaxVisibleResults;
+        set
+        {
+            if (double.IsNaN(value))
