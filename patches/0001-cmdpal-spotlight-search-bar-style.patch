diff --git a/src/modules/cmdpal/Microsoft.CmdPal.UI.ViewModels/SettingsModel.cs b/src/modules/cmdpal/Microsoft.CmdPal.UI.ViewModels/SettingsModel.cs
index 5798c9c..ea7bfc8 100644
--- a/src/modules/cmdpal/Microsoft.CmdPal.UI.ViewModels/SettingsModel.cs
+++ b/src/modules/cmdpal/Microsoft.CmdPal.UI.ViewModels/SettingsModel.cs
@@ -136,6 +136,69 @@ public record SettingsModel
     // when compact mode is off.
     public int CompactCenterHeightPercentage { get; set; } = DefaultCompactCenterHeightPercentage;
 
+    ///////////////////////////////////////////////////////////////////////////
+    // SpotPalette: Spotlight-style customization. These only take effect while
+    // CompactMode is on (the "search bar only" design); the official full palette
+    // ignores them entirely.
+    internal const int MinSpotlightMaxVisibleResults = 0; // 0 = fill the available space
+    internal const int MaxSpotlightMaxVisibleResults = 20;
+    internal const int DefaultSpotlightMaxVisibleResults = 8;
+    internal const int MinSpotlightSearchFontSize = 12;
+    internal const int MaxSpotlightSearchFontSize = 36;
+    internal const int DefaultSpotlightSearchFontSize = 22;
+    internal const int MinSpotlightCornerRadius = 0;
+    internal const int MaxSpotlightCornerRadius = 32;
+    internal const int DefaultSpotlightCornerRadius = 14;
+    internal const int MinSpotlightSearchBarPadding = 4;
+    internal const int MaxSpotlightSearchBarPadding = 32;
+    internal const int DefaultSpotlightSearchBarPadding = 14;
+
+    private int _spotlightMaxVisibleResults = DefaultSpotlightMaxVisibleResults;
+
+    /// <summary>
+    /// Gets the maximum number of result rows shown when the compact search bar expands.
+    /// 0 lets the results grow until the bottom of the screen (upstream behavior).
+    /// </summary>
+    public int SpotlightMaxVisibleResults
+    {
+        get => _spotlightMaxVisibleResults;
+        init => _spotlightMaxVisibleResults = Math.Clamp(value, MinSpotlightMaxVisibleResults, MaxSpotlightMaxVisibleResults);
+    }
+
+    private int _spotlightSearchFontSize = DefaultSpotlightSearchFontSize;
+
+    public int SpotlightSearchFontSize
+    {
+        get => _spotlightSearchFontSize;
+        init => _spotlightSearchFontSize = Math.Clamp(value, MinSpotlightSearchFontSize, MaxSpotlightSearchFontSize);
+    }
+
+    private int _spotlightSearchBarPadding = DefaultSpotlightSearchBarPadding;
+
+    /// <summary>
+    /// Gets the vertical padding (DIPs, top and bottom) around the search box. Together with
+    /// <see cref="SpotlightSearchFontSize"/> this controls how tall the search bar looks.
+    /// </summary>
+    public int SpotlightSearchBarPadding
+    {
+        get => _spotlightSearchBarPadding;
+        init => _spotlightSearchBarPadding = Math.Clamp(value, MinSpotlightSearchBarPadding, MaxSpotlightSearchBarPadding);
+    }
+
+    private int _spotlightCornerRadius = DefaultSpotlightCornerRadius;
+
+    public int SpotlightCornerRadius
+    {
+        get => _spotlightCornerRadius;
+        init => _spotlightCornerRadius = Math.Clamp(value, MinSpotlightCornerRadius, MaxSpotlightCornerRadius);
+    }
+
+    public bool SpotlightHideCommandBar { get; init; } = true;
+
+    public bool SpotlightHideLogo { get; init; }
+
+    public bool SpotlightHideSectionHeaders { get; init; }
+
     private ImmutableDictionary<string, ProviderSettings>? _providerSettings
         = ImmutableDictionary<string, ProviderSettings>.Empty;
 
